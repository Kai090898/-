-- 飛行開關
PluginTab:CreateToggle({
   Name = "飛行",
   CurrentValue = false,
   Flag = "Flying",
   Callback = function(Value)
      PlayerValues.Flying = Value
      
      if Value then
         -- 開啟飛行
         local player = game.Players.LocalPlayer
         local character = player.Character
         local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
         
         if humanoidRootPart then
            local bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            bodyVelocity.Parent = humanoidRootPart
            bodyVelocity.Name = "FlyVelocity"
            
            local connection
            connection = game:GetService("RunService").RenderStepped:Connect(function()
               if not PlayerValues.Flying then
                  bodyVelocity:Destroy()
                  connection:Disconnect()
                  return
               end
               
               local camera = workspace.CurrentCamera
               local moveDirection = Vector3.new(0, 0, 0)
               
               if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.W) then
                  moveDirection = moveDirection + (camera.CFrame.LookVector * PlayerValues.FlySpeed)
               end
               if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.S) then
                  moveDirection = moveDirection - (camera.CFrame.LookVector * PlayerValues.FlySpeed)
               end
               if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.A) then
                  moveDirection = moveDirection - (camera.CFrame.RightVector * PlayerValues.FlySpeed)
               end
               if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.D) then
                  moveDirection = moveDirection + (camera.CFrame.RightVector * PlayerValues.FlySpeed)
               end
               
               bodyVelocity.Velocity = moveDirection
            end)
         end
         
         Rayfield:Notify({
            Title = "飛行已開啟",
            Content = "使用 WASD 控制飛行方向",
            Duration = 2,
            Image = 4483362458
         })
      else
         -- 關閉飛行
         local character = game.Players.LocalPlayer.Character
         local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
         
         if humanoidRootPart then
            local flyVelocity = humanoidRootPart:FindFirstChild("FlyVelocity")
            if flyVelocity then
               flyVelocity:Destroy()
            end
         end
         
         Rayfield:Notify({
            Title = "飛行已關閉",
            Content = "飛行已停止",
            Duration = 2,
            Image = 4483362458
         })
      end
   end
})

-- 透視玩家開關
PluginTab:CreateToggle({
   Name = "透視玩家",
   CurrentValue = false,
   Flag = "ESP",
   Callback = function(Value)
      PlayerValues.ESP = Value
      
      if Value then
         -- 開啟透視
         local players = game:GetService("Players"):GetPlayers()
         
         for _, player in pairs(players) do
            if player ~= game.Players.LocalPlayer and player.Character then
               local character = player.Character
               for _, part in pairs(character:GetDescendants()) do
                  if part:IsA("BasePart") then
                     part.CanCollide = false
                     part.Transparency = 0.3
                  end
               end
            end
         end
         
         Rayfield:Notify({
            Title = "透視玩家已開啟",
            Content = "其他玩家現在是半透明的",
            Duration = 2,
            Image = 4483362458
         })
      else
         -- 關閉透視
         local players = game:GetService("Players"):GetPlayers()
         
         for _, player in pairs(players) do
            if player ~= game.Players.LocalPlayer and player.Character then
               local character = player.Character
               for _, part in pairs(character:GetDescendants()) do
                  if part:IsA("BasePart") then
                     part.Transparency = 0
                  end
               end
            end
         end
         
         Rayfield:Notify({
            Title = "透視玩家已關閉",
            Content = "玩家恢復正常顯示",
            Duration = 2,
            Image = 4483362458
         })
      end
   end
})

-- 重置按鈕
ModifierTab:CreateButton({
