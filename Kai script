-- 透視玩家開關 (Box ESP)
PluginTab:CreateToggle({
   Name = "透視玩家",
   CurrentValue = false,
   Flag = "ESP",
   Callback = function(Value)
      PlayerValues.ESP = Value
      
      if Value then
         -- 開啟透視
         local players = game:GetService("Players"):GetPlayers()
         local camera = workspace.CurrentCamera
         
         for _, player in pairs(players) do
            if player ~= game.Players.LocalPlayer and player.Character then
               local character = player.Character
               local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
               
               if humanoidRootPart then
                  -- 創建外框 (Box)
                  local box = Instance.new("Part")
                  box.Name = "ESPBox_" .. player.Name
                  box.Shape = Enum.PartType.Block
                  box.Material = Enum.Material.Neon
                  box.Color = Color3.fromRGB(0, 255, 0)
                  box.CanCollide = false
                  box.CFrame = humanoidRootPart.CFrame
                  box.Transparency = 0.7
                  box.TopSurface = Enum.SurfaceType.Smooth
                  box.BottomSurface = Enum.SurfaceType.Smooth
                  box.Parent = workspace
                  
                  -- 縮放外框以適應角色大小
                  box.Size = Vector3.new(3, 5, 3)
                  
                  -- 保存外框參考
                  if not PlayerValues.ESPBoxes[player.Name] then
                     PlayerValues.ESPBoxes[player.Name] = {}
                  end
                  PlayerValues.ESPBoxes[player.Name].box = box
                  
                  -- 持續更新外框位置
                  local connection
                  connection = game:GetService("RunService").RenderStepped:Connect(function()
                     if not PlayerValues.ESP or not player.Parent or not character.Parent then
                        if box and box.Parent then
                           box:Destroy()
                        end
                        connection:Disconnect()
                        PlayerValues.ESPBoxes[player.Name] = nil
                        return
                     end
                     
                     if humanoidRootPart and box then
                        box.CFrame = humanoidRootPart.CFrame
                     end
                  end)
                  
                  PlayerValues.ESPBoxes[player.Name].connection = connection
               end
            end
         end
         
         Rayfield:Notify({
            Title = "透視玩家已開啟",
            Content = "玩家位置外框已顯示",
            Duration = 2,
            Image = 4483362458
         })
      else
         -- 關閉透視
         for playerName, data in pairs(PlayerValues.ESPBoxes) do
            if data.box and data.box.Parent then
               data.box:Destroy()
            end
            if data.connection then
               data.connection:Disconnect()
            end
         end
         PlayerValues.ESPBoxes = {}
         
         Rayfield:Notify({
            Title = "透視玩家已關閉",
            Content = "玩家外框已移除",
            Duration = 2,
            Image = 4483362458
         })
      end
   end
})

