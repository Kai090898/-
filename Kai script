-- 穿牆開關 (改進版本)
ModifierTab:CreateToggle({
   Name = "穿牆",
   CurrentValue = false,
   Flag = "Noclip",
   Callback = function(Value)
      if Value then
         -- 開啟穿牆
         local player = game.Players.LocalPlayer
         local character = player.Character
         
         if character then
            -- 禁用所有部件的碰撞
            for _, part in pairs(character:GetDescendants()) do
               if part:IsA("BasePart") then
                  part.CanCollide = false
               end
            end
            
            -- 創建持續穿牆的連接
            if PlayerValues.NoclipConnection then
               PlayerValues.NoclipConnection:Disconnect()
            end
            
            PlayerValues.NoclipConnection = game:GetService("RunService").Heartbeat:Connect(function()
               if not PlayerValues.Noclip then
                  return
               end
               
               local character = player.Character
               if character then
                  for _, part in pairs(character:GetDescendants()) do
                     if part:IsA("BasePart") then
                        part.CanCollide = false
                     end
                  end
               end
            end)
         end
         
         PlayerValues.Noclip = true
         
         Rayfield:Notify({
            Title = "穿牆已開啟",
            Content = "你現在可以穿過所有牆壁",
            Duration = 2,
            Image = 4483362458
         })
      else
         -- 關閉穿牆
         PlayerValues.Noclip = false
         
         if PlayerValues.NoclipConnection then
            PlayerValues.NoclipConnection:Disconnect()
            PlayerValues.NoclipConnection = nil
         end
         
         local player = game.Players.LocalPlayer
         local character = player.Character
         
         if character then
            for _, part in pairs(character:GetDescendants()) do
               if part:IsA("BasePart") then
                  part.CanCollide = true
               end
            end
         end
         
         Rayfield:Notify({
            Title = "穿牆已關閉",
            Content = "碰撞已恢復",
            Duration = 2,
            Image = 4483362458
         })
      end
   end
})

