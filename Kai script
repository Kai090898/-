-- 透視玩家開關 (改進版本 - 外框 + 名稱標籤)
PluginTab:CreateToggle({
   Name = "透視玩家",
   CurrentValue = false,
   Flag = "ESP",
   Callback = function(Value)
      PlayerValues.ESP = Value
      
      if Value then
         -- 開啟透視
         local players = game:GetService("Players"):GetPlayers()
         
         for _, player in pairs(players) do
            if player ~= game.Players.LocalPlayer and player.Character then
               CreateESP(player, PlayerValues)
            end
         end
         
         -- 監聽新玩家加入
         local connection = game:GetService("Players").PlayerAdded:Connect(function(player)
            if PlayerValues.ESP and player ~= game.Players.LocalPlayer then
               wait(0.5) -- 等待角色加載
               if player.Character then
                  CreateESP(player, PlayerValues)
               end
            end
         end)
         
         PlayerValues.ESPConnection = connection
         
         Rayfield:Notify({
            Title = "透視玩家已開啟",
            Content = "玩家位置外框已顯示",
            Duration = 2,
            Image = 4483362458
         })
      else
         -- 關閉透視
         if PlayerValues.ESPConnection then
            PlayerValues.ESPConnection:Disconnect()
            PlayerValues.ESPConnection = nil
         end
         
         for playerName, data in pairs(PlayerValues.ESPBoxes) do
            if data.box and data.box.Parent then
               data.box:Destroy()
            end
            if data.nameLabel and data.nameLabel.Parent then
               data.nameLabel:Destroy()
            end
            if data.connection then
               data.connection:Disconnect()
            end
         end
         PlayerValues.ESPBoxes = {}
         
         Rayfield:Notify({
            Title = "透視玩家已關閉",
            Content = "玩家外框已移除",
            Duration = 2,
            Image = 4483362458
         })
      end
   end
})

-- 創建ESP函數
function CreateESP(player, values)
   if not player.Character then return end
   
   local character = player.Character
   local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
   
   if not humanoidRootPart then return end
   
   -- 創建外框 (Box)
   local box = Instance.new("Part")
   box.Name = "ESPBox_" .. player.Name
   box.Shape = Enum.PartType.Block
   box.Material = Enum.Material.Neon
   box.Color = Color3.fromRGB(0, 255, 0)
   box.CanCollide = false
   box.CFrame = humanoidRootPart.CFrame
   box.Transparency = 0.5
   box.TopSurface = Enum.SurfaceType.Smooth
   box.BottomSurface = Enum.SurfaceType.Smooth
   box.Size = Vector3.new(3, 5, 3)
   box.Parent = workspace
   
   -- 穿透牆壁設置
   local boxSurface = Instance.new("SurfaceGui")
   boxSurface.Parent = box
   boxSurface.Face = Enum.NormalId.Front
   
   -- 創建玩家名稱標籤
   local nameLabel = Instance.new("Part")
   nameLabel.Name = "ESPLabel_" .. player.Name
   nameLabel.Shape = Enum.PartType.Block
   nameLabel.Material = Enum.Material.Neon
   nameLabel.Color = Color3.fromRGB(0, 255, 0)
   nameLabel.CanCollide = false
   nameLabel.Transparency = 0.3
   nameLabel.TopSurface = Enum.SurfaceType.Smooth
   nameLabel.BottomSurface = Enum.SurfaceType.Smooth
   nameLabel.Size = Vector3.new(0.1, 0.1, 0.1)
   nameLabel.Parent = workspace
   
   -- 在名稱標籤上添加文本
   local textLabel = Instance.new("TextLabel")
   textLabel.Name = "NameText"
   textLabel.BackgroundTransparency = 1
   textLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
   textLabel.TextSize = 24
   textLabel.Font = Enum.Font.GothamBold
   textLabel.Text = player.Name
   textLabel.TextScaled = true
   textLabel.Parent = nameLabel
   
   local billboardGui = Instance.new("BillboardGui")
   billboardGui.Size = UDim2.new(4, 0, 2, 0)
   billboardGui.MaxDistance = math.huge
   billboardGui.Parent = nameLabel
   
   textLabel.Parent = billboardGui
   
   -- 保存參考
   if not values.ESPBoxes[player.Name] then
      values.ESPBoxes[player.Name] = {}
   end
   values.ESPBoxes[player.Name].box = box
   values.ESPBoxes[player.Name].nameLabel = nameLabel
   
   -- 持續更新位置
   local connection
   connection = game:GetService("RunService").RenderStepped:Connect(function()
      if not values.ESP or not player.Parent or not character.Parent then
         if box and box.Parent then
            box:Destroy()
         end
         if nameLabel and nameLabel.Parent then
            nameLabel:Destroy()
         end
         connection:Disconnect()
         values.ESPBoxes[player.Name] = nil
         return
      end
      
      if humanoidRootPart and box then
         box.CFrame = humanoidRootPart.CFrame
         nameLabel.Position = humanoidRootPart.Position + Vector3.new(0, 3, 0)
      end
   end)
   
   values.ESPBoxes[player.Name].connection = connection
end

