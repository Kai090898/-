-- 隱形開關
PluginTab:CreateToggle({
   Name = "隱形",
   CurrentValue = false,
   Flag = "Invisible",
   Callback = function(Value)
      PlayerValues.Invisible = Value
      
      if Value then
         -- 開啟隱形
         local player = game.Players.LocalPlayer
         local character = player.Character
         
         if character then
            -- 保存原本的透明度
            for _, part in pairs(character:GetDescendants()) do
               if part:IsA("BasePart") then
                  PlayerValues.OriginalTransparency[part] = part.Transparency
                  part.Transparency = 1
               end
            end
            
            -- 隱藏角色配件
            local humanoid = character:FindFirstChild("Humanoid")
            if humanoid then
               humanoid.HealthDisplayDistance = 0
               humanoid.NameDisplayDistance = 0
            end
         end
         
         Rayfield:Notify({
            Title = "隱形已開啟",
            Content = "你已隱形",
            Duration = 2,
            Image = 4483362458
         })
      else
         -- 關閉隱形
         local player = game.Players.LocalPlayer
         local character = player.Character
         
         if character then
            -- 恢復原本的透明度
            for part, transparency in pairs(PlayerValues.OriginalTransparency) do
               if part and part.Parent then
                  part.Transparency = transparency
               end
            end
            PlayerValues.OriginalTransparency = {}
            
            -- 恢復角色配件顯示
            local humanoid = character:FindFirstChild("Humanoid")
            if humanoid then
               humanoid.HealthDisplayDistance = 100
               humanoid.NameDisplayDistance = 100
            end
         end
         
         Rayfield:Notify({
            Title = "隱形已關閉",
            Content = "你已恢復可見",
            Duration = 2,
            Image = 4483362458
         })
      end
   end
})

-- 透視玩家開關 (使用 Billboard GUI)
PluginTab:CreateToggle({
   Name = "透視玩家",
   CurrentValue = false,
   Flag = "ESP",
   Callback = function(Value)
      PlayerValues.ESP = Value
      
      if Value then
         -- 開啟透視
         local players = game:GetService("Players"):GetPlayers()
         
         for _, player in pairs(players) do
            if player ~= game.Players.LocalPlayer and player.Character then
               CreateBillboardESP(player, PlayerValues)
            end
         end
         
         -- 監聽新玩家加入
         local connection = game:GetService("Players").PlayerAdded:Connect(function(player)
            if PlayerValues.ESP and player ~= game.Players.LocalPlayer then
               wait(0.5)
               if player.Character then
                  CreateBillboardESP(player, PlayerValues)
               end
            end
         end)
         
         PlayerValues.ESPConnection = connection
         
         Rayfield:Notify({
            Title = "透視玩家已開啟",
            Content = "玩家位置標籤已顯示",
            Duration = 2,
            Image = 4483362458
         })
      else
         -- 關閉透視
         if PlayerValues.ESPConnection then
            PlayerValues.ESPConnection:Disconnect()
            PlayerValues.ESPConnection = nil
         end
         
         for playerName, data in pairs(PlayerValues.ESPBoxes) do
            if data.billboard and data.billboard.Parent then
               data.billboard:Destroy()
            end
            if data.connection then
               data.connection:Disconnect()
            end
         end
         PlayerValues.ESPBoxes = {}
         
         Rayfield:Notify({
            Title = "透視玩家已關閉",
            Content = "玩家標籤已移除",
            Duration = 2,
            Image = 4483362458
         })
      end
   end
})

-- 創建 Billboard GUI ESP
function CreateBillboardESP(player, values)
   if not player.Character then return end
   
   local character = player.Character
   local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
   
   if not humanoidRootPart then return end
   
   -- 創建 Billboard GUI
   local billboard = Instance.new("BillboardGui")
   billboard.Name = "ESPBillboard_" .. player.Name
   billboard.Size = UDim2.new(4, 0, 2, 0)
   billboard.MaxDistance = math.huge
   billboard.Adornee = humanoidRootPart
   billboard.Parent = humanoidRootPart
   
   -- 創建背景框
   local frame = Instance.new("Frame")
   frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
   frame.BackgroundTransparency = 0.5
   frame.BorderSizePixel = 2
   frame.BorderColor3 = Color3.fromRGB(0, 255, 0)
   frame.Size = UDim2.new(1, 0, 1, 0)
   frame.Parent = billboard
   
   -- 創建玩家名稱標籤
   local nameLabel = Instance.new("TextLabel")
   nameLabel.Name = "PlayerName"
   nameLabel.BackgroundTransparency = 1
   nameLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
   nameLabel.TextSize = 18
   nameLabel.Font = Enum.Font.GothamBold
   nameLabel.Text = player.Name
   nameLabel.TextScaled = true
   nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
   nameLabel.Position = UDim2.new(0, 0, 0, 0)
   nameLabel.Parent = frame
   
   -- 創建距離標籤
   local distanceLabel = Instance.new("TextLabel")
   distanceLabel.Name = "Distance"
   distanceLabel.BackgroundTransparency = 1
   distanceLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
   distanceLabel.TextSize = 14
   distanceLabel.Font = Enum.Font.Gotham
   distanceLabel.Text = "距離: 0m"
   distanceLabel.TextScaled = true
   distanceLabel.Size = UDim2.new(1, 0, 0.5, 0)
   distanceLabel.Position = UDim2.new(0, 0, 0.5, 0)
   distanceLabel.Parent = frame
   
   -- 保存參考
   if not values.ESPBoxes[player.Name] then
      values.ESPBoxes[player.Name] = {}
   end
   values.ESPBoxes[player.Name].billboard = billboard
   values.ESPBoxes[player.Name].distanceLabel = distanceLabel
   
   -- 持續更新距離
   local connection
   connection = game:GetService("RunService").RenderStepped:Connect(function()
      if not values.ESP or not player.Parent or not character.Parent then
         if billboard and billboard.Parent then
            billboard:Destroy()
         end
         connection:Disconnect()
         values.ESPBoxes[player.Name] = nil
         return
      end
      
      if humanoidRootPart and distanceLabel then
         local playerPos = game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
         if playerPos then
            local distance = (humanoidRootPart.Position - playerPos.Position).Magnitude
            distanceLabel.Text = string.format("距離: %.1fm", distance)
         end
      end
   end)
   
   values.ESPBoxes[player.Name].connection = connection
end

