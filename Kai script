   Callback = function()
      PlayerValues.JumpPower = 50
      PlayerValues.WalkSpeed = 16
      PlayerValues.Gravity = 196.2
      PlayerValues.Noclip = false
      PlayerValues.Flying = false
      PlayerValues.FlySpeed = 50
